{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "captura-coordenada",
  "description": "Capability for the coordinate-capture overlay window (and its per-row preview siblings, one label per coordinate previsualized at once — Etapa F)",
  "windows": ["captura_coordenada", "captura_coordenada_preview_*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-scale-factor",
    "core:window:allow-outer-position"
  ]
}